{
  "info": {
    "name": "ticket-service",
    "description": "Coleção básica pra testar a API do ticket-service (Gin). Configure base_url pra apontar pro servidor local (go run) ou pro docker-compose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:18080", "type": "string" },
    { "key": "ticket_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/healthz", "host": ["{{base_url}}"], "path": ["healthz"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Open Ticket",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Impressora não liga\",\n  \"description\": \"A impressora do 3º andar não liga mais\",\n  \"priority\": \"High\"\n}"
        },
        "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('ticket_id', body.ticket_id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Ticket",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/tickets/{{ticket_id}}",
          "host": ["{{base_url}}"],
          "path": ["tickets", "{{ticket_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Assign Ticket",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assignee_id\": \"agent-1\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tickets/{{ticket_id}}/assign",
          "host": ["{{base_url}}"],
          "path": ["tickets", "{{ticket_id}}", "assign"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Change Priority",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"priority\": \"Low\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tickets/{{ticket_id}}/priority",
          "host": ["{{base_url}}"],
          "path": ["tickets", "{{ticket_id}}", "priority"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Move To In Progress",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/tickets/{{ticket_id}}/start",
          "host": ["{{base_url}}"],
          "path": ["tickets", "{{ticket_id}}", "start"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Add Response",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author_id\": \"agent-1\",\n  \"content\": \"Já estou verificando\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tickets/{{ticket_id}}/responses",
          "host": ["{{base_url}}"],
          "path": ["tickets", "{{ticket_id}}", "responses"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Close Ticket",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/tickets/{{ticket_id}}/close",
          "host": ["{{base_url}}"],
          "path": ["tickets", "{{ticket_id}}", "close"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
